<div class="dashboard">
  <h1>Challenges</h1>
  <% Object.entries(challengesByLevel).forEach(([level, levelChallenges]) => { %>
    <section class="challenge-level">
      <h2>Level <%= level %></h2>
      <ul>
        <% levelChallenges.forEach((challenge) => { %>
          <li data-challenge-id="<%= challenge.id %>">
            <h3>
              <% if (challenge.href) { %>
                <a href="<%= challenge.href %>"><%= challenge.title %></a>
              <% } else { %>
                <%= challenge.title %>
              <% } %>
              <span class="challenge-status"><%= challenge.status %></span>
            </h3>
            <p><%= challenge.description %></p>
          </li>
        <% }); %>
      </ul>
    </section>
  <% }); %>
</div>